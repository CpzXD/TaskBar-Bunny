{
  "name": "taskbar-bunny",
  "version": "1.3.0",
  "description": "Taskbar Bunny",
  "main": "src/main/main.js",
  "scripts": {
    "test": "node --test tests/test_game_systems.js",
    "build:renderer": "node build.js",
    "start": "node build.js && electron .",
    "build": "node build.js && electron-builder --win",
    "build:portable": "node build.js && electron-builder --win portable",
    "pack": "node build.js && electron-builder --dir"
  },
  "author": "CpzXD",
  "contributors": [
    "Qnoxs (Game Designer / Tester)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CpzXD/TaskBar-Bunny.git"
  },
  "homepage": "https://github.com/CpzXD/TaskBar-Bunny#readme",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.taskbarbunny.app",
    "productName": "Taskbar Bunny",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
